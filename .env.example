# Template for .env (repo root). Copy it: `cp .env.example .env`. .env is gitignored and holds
# secrets: never commit it, keep it readable only by you (chmod 600).
# The make targets fill most of it for you; see `make help`.

# ---- Web UI login (make modal-secret) --------------------------------------------------------
# Your password for the sign-in screen. Leave empty and `make modal-secret` generates a random one.
# After changing it: `make modal-secret FORCE=1 && make modal-deploy`.
UI_PASSWORD=
# Browser origins allowed to call the API, comma-separated (add the Vercel address when deployed).
UI_ORIGINS=http://localhost:5173

# ---- Modal proxy-auth token for scripts/deploy/query_modal.py (make modal-token) ---------------
# Calls the model server directly; the web UI does not need it. Format: wk-... / ws-...
MODAL_KEY=
MODAL_SECRET=

# ---- Optional experiment loggers (configs/logger/*.yaml) --------------------------------------
# COMET_API_TOKEN=
# NEPTUNE_API_TOKEN=
