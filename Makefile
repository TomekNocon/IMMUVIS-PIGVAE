# Common tasks. Training runs on the cluster through SLURM (scripts/slurm/); run `make` for help.

EXPERIMENT ?= pigvae
# Modal GPU for the model server; set GPU=L4 once the Modal account has a payment method.
GPU ?= none

.PHONY: help install lint format test test-full train clean clean-logs \
	modal-login modal-bundle modal-secret modal-deploy modal-token modal-api modal-stop \
	ui-install ui-dev ui-mock ui-build

help: ## Show this help
	@grep -E '^[.a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-14s\033[0m %s\n", $$1, $$2}'

install: ## Create the environment (uv), install the git pre-commit hooks, create .env from the template
	uv sync
	git submodule update --init --recursive
	uv run pre-commit install
	@test -f .env || (cp .env.example .env && chmod 600 .env && echo "created .env from .env.example")

lint: ## Check style without modifying files
	uv run ruff check .
	uv run ruff format --check .

format: ## Run all pre-commit hooks on every file (fixes in place)
	uv run pre-commit run --all-files

test: ## Run the fast tests
	uv run pytest -m "not slow"

test-full: ## Run all tests (the integration tests need the IMC data, i.e. szary)
	uv run pytest

train: ## Submit a training job: make train [EXPERIMENT=ablation/kl/scale_1e-3]
	mkdir -p logs/slurm
	sbatch --export=ALL,EXPERIMENT=$(EXPERIMENT) scripts/slurm/train.sh

# ---- Model service on Modal (src/deploy/; first time: login, bundle, secret, deploy) ----------

modal-login: ## Log in to Modal (opens a browser link); skipped when already logged in
	@if uv run modal token info >/dev/null 2>&1; then \
		echo "Already logged in to Modal (uv run modal token info). To log in again: uv run modal setup"; \
	else uv run modal setup; fi

modal-bundle: ## Export the model bundle and upload it to the Modal Volume (SLURM job on szary)
	mkdir -p logs/slurm
	sbatch scripts/slurm/deploy_bundle.sh

modal-secret: ## UI password (.env) -> Modal Secret, only if missing [FORCE=1 | NEW_PASSWORD=1]
	uv run python scripts/deploy/credentials.py ui-secret $(if $(FORCE),--force) $(if $(NEW_PASSWORD),--new-password)

modal-deploy: ## Deploy the model server and the API gateway [GPU=none|L4]
	PIGVAE_GPU=$(GPU) uv run modal deploy src/deploy/modal/app.py

modal-token: ## Create a proxy-auth token for scripts/deploy/query_modal.py (saved to .env)
	uv run python scripts/deploy/credentials.py proxy-token

modal-api: ## Regenerate the API contract: src/deploy/openapi.json and the UI's TypeScript types
	uv run python scripts/deploy/export_openapi.py
	cd ui && pnpm gen:api

modal-stop: ## Take the Modal app offline (modal-deploy brings it back)
	uv run modal app stop pigvae-imc

# ---- Frontend (ui/) --------------------------------------------------------------------------

ui-install: ## Install the UI dependencies and create ui/.env.local from the example
	cd ui && pnpm install
	test -f ui/.env.local || cp ui/.env.example ui/.env.local

ui-dev: ## Run the UI against the deployed API on localhost:5173
	cd ui && pnpm dev

ui-mock: ## Run the UI on recorded responses (no server or password needed)
	cd ui && pnpm dev:mock

ui-build: ## Type-check, lint and build the UI into ui/dist
	cd ui && pnpm build && pnpm lint

# ----------------------------------------------------------------------------------------------

clean: ## Remove caches and autogenerated files
	rm -rf dist ui/dist .coverage
	find . -name "*.DS_Store" -delete
	find . -type d \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache -o -name .ipynb_checkpoints \) -prune -exec rm -rf {} +

clean-logs: ## Remove the local logs/ folder (the raid logs are untouched)
	rm -rf logs/**
