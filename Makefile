# Common tasks; run `make` for help.

ARGS ?=

.PHONY: help install lint format test test-full train clean clean-logs

help: ## Show this help
	@grep -E '^[.a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-12s\033[0m %s\n", $$1, $$2}'

install: ## Create the environment (uv) and install the git pre-commit hooks
	uv sync
	git submodule update --init --recursive
	uv run pre-commit install

lint: ## Check style without modifying files
	uv run ruff check .
	uv run ruff format --check .

format: ## Run all pre-commit hooks on every file (fixes in place)
	uv run pre-commit run --all-files

test: ## Run the fast tests
	uv run pytest -m "not slow"

test-full: ## Run all tests
	uv run pytest

train: ## Train locally: make train [ARGS="trainer.max_epochs=10 logger=csv"]
	uv run python src/train.py $(ARGS)

clean: ## Remove caches and autogenerated files
	rm -rf dist .coverage
	find . -name "*.DS_Store" -delete
	find . -type d \( -name __pycache__ -o -name .pytest_cache -o -name .ruff_cache -o -name .ipynb_checkpoints \) -prune -exec rm -rf {} +

clean-logs: ## Remove the local logs/ folder (the raid logs are untouched)
	rm -rf logs/**
